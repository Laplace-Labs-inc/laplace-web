---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Enterprise concurrency verification platform." } = Astro.props;
const pageTitle = `${title} - Laplace Labs`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {/* Pre-paint theme bootstrap — MUST stay first to avoid FOUC.
        Keep byte-identical to shared/theme-init.js. */}
    <script is:inline>
      (function () {
        try {
          var s = localStorage.getItem("laplace-theme");
          var t = s === "light" || s === "dark" ? s
            : window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
          document.documentElement.setAttribute("data-theme", t);
        } catch (e) {
          document.documentElement.setAttribute("data-theme", "light");
        }
      })();
    </script>
    <meta property="og:site_name" content="Laplace Labs" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-brand-bg text-fg font-sans antialiased">
    <slot />
  </body>
</html>
