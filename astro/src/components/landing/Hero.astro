<section class="relative flex min-h-[90vh] flex-col items-center justify-center overflow-hidden bg-mesh-gradient px-6 text-center">
  <div
    class="absolute inset-0 opacity-[0.03]"
    style="background-image: url(&quot;data:image/svg+xml,%3Csvg width='60' height='60' viewBox='0 0 60 60' xmlns='http://www.w3.org/2000/svg'%3E%3Cg fill='none' fill-rule='evenodd'%3E%3Cg fill='%23ffffff' fill-opacity='1'%3E%3Cpath d='M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z'/%3E%3C/g%3E%3C/g%3E%3C/svg%3E&quot;)"
  ></div>

  <div class="relative z-10 max-w-5xl space-y-8">
    <div class="inline-flex items-center gap-2 rounded-full border border-brand-border bg-brand-surface px-4 py-1.5 text-sm text-brand-muted">
      <span class="h-2 w-2 animate-pulse rounded-full bg-brand-accent"></span>
      Beta opens October 2026 - Join the waitlist
    </div>

    <h1 class="text-6xl font-black leading-[0.9] tracking-tighter md:text-8xl">
      Eradicate<br />
      <span class="hero-gradient-word">
        Heisenbugs.
      </span><br />
      Provably.
    </h1>

    <p class="mx-auto max-w-3xl text-xl leading-relaxed text-brand-muted md:text-2xl">
      DPOR formal verification for production Rust systems.
      Find concurrency bugs your test suite missed - deterministically, before they reach production.
    </p>

    <div class="flex flex-col items-center justify-center gap-4 sm:flex-row">
      <button
        type="button"
        data-copy-install
        data-command="curl -fsSL https://install.laplace-labs.com | sh"
        class="group rounded-2xl border border-brand-border bg-brand-surface px-5 py-3 text-left font-mono text-sm text-fg transition-colors hover:border-brand-accent"
      >
        <span class="block text-xs uppercase text-brand-muted" data-copy-label>Copy install</span>
        <code>curl -fsSL https://install.laplace-labs.com | sh</code>
      </button>
      <a href="https://docs.laplace-labs.com/" class="rounded-full border border-brand-border px-8 py-4 text-lg font-semibold text-fg transition-colors hover:bg-brand-surface">
        View Docs ↗
      </a>
    </div>
    <p class="text-sm text-brand-muted">
      Beta waitlist: <a href="/#waitlist" class="font-medium text-brand-accent hover:underline">request access</a>
    </p>
  </div>
  <script is:inline>
    document.querySelectorAll("[data-copy-install]").forEach(function (button) {
      button.addEventListener("click", async function () {
        var label = button.querySelector("[data-copy-label]");
        try {
          await navigator.clipboard.writeText(button.getAttribute("data-command") || "");
          label.textContent = "Copied";
          setTimeout(function () { label.textContent = "Copy install"; }, 1600);
        } catch (e) {
          label.textContent = "Copy failed";
        }
      });
    });
  </script>
</section>
