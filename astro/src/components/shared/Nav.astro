---
import ThemeToggle from "./ThemeToggle.astro";
const links = [
  { label: "Docs", href: "https://docs.laplace-labs.com/" },
  { label: "Case Studies", href: "/blog/case-studies/" },
  { label: "Pricing", href: "/pricing" },
  { label: "GitHub", href: "https://github.com/Laplace-Labs-inc", external: true },
];
---
<header class="sticky top-0 z-50 border-b border-brand-border bg-brand-bg/80 backdrop-blur-md">
  <div class="mx-auto flex max-w-7xl items-center justify-between px-6 py-4">
    <a href="/" class="flex items-center">
      <img src="/images/Laplace_labs.svg" alt="Laplace Labs" class="h-12 w-auto object-contain dark:hidden" />
      <img src="/images/Laplace_labs-dark.svg" alt="Laplace Labs" class="hidden h-12 w-auto object-contain dark:block" />
    </a>

    <nav class="hidden items-center gap-8 text-sm font-medium text-brand-muted md:flex">
      {links.map((l) => (
        <a
          href={l.href}
          target={l.external ? "_blank" : undefined}
          rel={l.external ? "noreferrer" : undefined}
          class="transition-colors hover:text-fg"
        >
          {l.label}
        </a>
      ))}
    </nav>

    <div class="hidden items-center gap-3 md:flex">
      <ThemeToggle />
      <a
        href="/#waitlist"
        class="rounded-full bg-accent px-5 py-2 text-sm font-semibold text-accent-fg transition-opacity hover:opacity-90"
      >
        Join Waitlist -&gt;
      </a>
    </div>

    <details class="group relative md:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-brand-border px-4 py-2 text-sm font-semibold text-fg marker:hidden">
        Menu
      </summary>
      <div class="absolute right-0 mt-3 w-64 border border-brand-border bg-brand-bg p-4 shadow-[var(--shadow)]">
        <nav class="flex flex-col gap-3 text-sm font-medium text-brand-muted">
          {links.map((l) => (
            <a
              href={l.href}
              target={l.external ? "_blank" : undefined}
              rel={l.external ? "noreferrer" : undefined}
              class="transition-colors hover:text-fg"
            >
              {l.label}
            </a>
          ))}
          <a href="/#waitlist" class="rounded-full bg-accent px-4 py-2 text-center font-semibold text-accent-fg transition-opacity hover:opacity-90">
            Join Waitlist -&gt;
          </a>
          <div class="pt-1">
            <ThemeToggle />
          </div>
        </nav>
      </div>
    </details>
  </div>
</header>
